# =========================================================
# RECAUDO-T — configuración del experimento de disponibilidad
# Los valores pueden sobreescribirse con variables de entorno
# del mismo nombre (por ejemplo al correr bajo Docker).
# =========================================================

# --- Monitor Ping/Echo (T, t, k) ---
PING_INTERVAL=1
PING_TIMEOUT=0.3
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2

# --- Carga / experimento ---
CLIENT_RATE=20
EXPERIMENT_DURATION=40
FAILURE_INJECT_AT=15
TARGET_REPLICA=B
NUM_REPLICAS=3

# --- Red ---
DISPATCHER_PORT=8000
DISCOVERY_PORT=8000
REPLICA_BASE_PORT=8001

# --- URLs de réplicas (Docker usa nombres de servicio) ---
REPLICA_A_URL=http://127.0.0.1:8001
REPLICA_B_URL=http://127.0.0.1:8002
REPLICA_C_URL=http://127.0.0.1:8003

# --- Dispatcher para el cliente / frontend ---
DISPATCHER_URL=http://127.0.0.1:8000

# --- Archivos ---
MONITOR_LOG=logs/monitor.log
RESULTS_DIR=results